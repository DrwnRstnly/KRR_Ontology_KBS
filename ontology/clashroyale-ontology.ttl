# Deck must have exactly 8 cards
:hasCardExact8 a owl:Class ;
  owl:equivalentClass [ a owl:Class ;
    owl:intersectionOf (
      :Deck
      [ a owl:Restriction ; owl:onProperty :hasCard ; owl:qualifiedCardinality "8"^^xsd:nonNegativeInteger ; owl:onClass :Card ]
    )
  ] ;
  rdfs:label "DeckWithExactly8Cards" .

:HogCycleDeck a :Deck , :hasCardExact8 ;
  rdfs:label "Hog Cycle Deck" ;
  :usesWinCondition :HogWincon ;
  :hasCard :HogRider , :Fireball , :Cannon , :Musketeer , :IceGolem , :Skeletons , :IceSpirit , :TheLog .

#################################################################
# Helpful class definitions
#################################################################

# Wincon card pattern: cards that target buildings directly
:WinconCard a owl:Class ;
  owl:equivalentClass [ a owl:Class ;
    owl:intersectionOf ( :Card [ a owl:Restriction ; owl:onProperty :hasTargetType ; owl:hasValue :BuildingsOnly ] )
  ] ;
  rdfs:label "WinconCard" .

# Ranged troops
:RangedTroop a owl:Class ;
  owl:equivalentClass [ a owl:Class ;
    owl:intersectionOf ( :Troop [ a owl:Restriction ; owl:onProperty :hasDamageType ; owl:hasValue :Ranged ] )
  ] ;
  rdfs:label "RangedTroop" .

#################################################################
# Annotations and notes
#################################################################

:HogRider rdfs:comment "Fast ground troop that targets buildings" .
:Fireball rdfs:comment "Medium radius spell for finishing troops and towers" .
:Cannon rdfs:comment "Cheap defensive building" .
:Musketeer rdfs:comment "Long range single target support" .
:IceGolem rdfs:comment "Cheap tank with death slow" .
:Skeletons rdfs:comment "Cycle, kite, and dps for 1 elixir" .
:IceSpirit rdfs:comment "Cycle and freeze effect" .
:TheLog rdfs:comment "Rolls and knocks back ground units" .

<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/clashroyale#"
     xml:base="http://example.org/clashroyale"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
     <owl:Ontology rdf:about="urn:webprotege:ontology:09e23dab-8733-417d-bb6f-7eb1b504d40a"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/clashroyale#count -->

    <owl:AnnotationProperty rdf:about="http://example.org/clashroyale#count"/>
    


    <!-- http://example.org/clashroyale#hasSplash -->

    <owl:AnnotationProperty rdf:about="http://example.org/clashroyale#hasSplash"/>
    


    <!-- http://www.w3.org/2002/07/owl#SymmetricProperty -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    


    <!-- http://www.w3.org/2002/07/owl#functionalProperty -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#functionalProperty"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/clashroyale#counters -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#counters">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:label>counters</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#hasAbility -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#hasAbility">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#Ability"/>
        <rdfs:label>hasAbility</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#hasCard -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#hasCard">
        <owl:inverseOf rdf:resource="http://example.org/clashroyale#isInDeck"/>
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Deck"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:label>hasCard</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#hasDamageType -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#hasDamageType">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#DamageType"/>
        <rdfs:label>hasDamageType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#hasRangeType -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#hasRangeType">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#RangeType"/>
        <rdfs:label>hasRangeType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#hasRarity -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#hasRarity">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#Rarity"/>
        <rdfs:label>hasRarity</rdfs:label>
        <owl:functionalProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:functionalProperty>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#hasSpeedClass -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#hasSpeedClass">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Troop"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#SpeedClass"/>
        <rdfs:label>hasSpeedClass</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#hasTargetType -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#hasTargetType">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#TargetType"/>
        <rdfs:label>hasTargetType</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#inArena -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#inArena">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#Arena"/>
        <rdfs:label>inArena</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#isInDeck -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#isInDeck">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#Deck"/>
        <rdfs:label>isInDeck</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#synergizesWith -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#synergizesWith">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:label>synergizesWith</rdfs:label>
        <owl:SymmetricProperty rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:SymmetricProperty>
    </owl:ObjectProperty>
    


    <!-- http://example.org/clashroyale#usesWinCondition -->

    <owl:ObjectProperty rdf:about="http://example.org/clashroyale#usesWinCondition">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Deck"/>
        <rdfs:range rdf:resource="http://example.org/clashroyale#WinCondition"/>
        <rdfs:label>usesWinCondition</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/clashroyale#arenaLevel -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#arenaLevel">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Arena"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>arenaLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/clashroyale#attackSpeed -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#attackSpeed">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>attackSpeed</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/clashroyale#damage -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#damage">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>damage</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/clashroyale#dps -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#dps">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>dps</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/clashroyale#elixirCost -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#elixirCost">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>elixirCost</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/clashroyale#hitpoints -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#hitpoints">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hitpoints</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/clashroyale#lifetime -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#lifetime">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Building"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>lifetime</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/clashroyale#radius -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#radius">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Spell"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>radius</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://example.org/clashroyale#range -->

    <owl:DatatypeProperty rdf:about="http://example.org/clashroyale#range">
        <rdfs:domain rdf:resource="http://example.org/clashroyale#Card"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>range</rdfs:label>
    </owl:DatatypeProperty>
    


